{
    "kind": "collectionType",
    "collectionName": "lessons",
    "info": {
        "singularName": "lesson",
        "pluralName": "lessons",
        "displayName": "Lesson"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "Title": {
            "type": "string"
        },
        "Slug": {
            "type": "uid",
            "targetField": "Title",
            "required": true
        },
        "VideoUrl": {
            "type": "string"
        },
        "Content": {
            "type": "blocks"
        },
        "Duration": {
            "type": "string"
        },
        "isPreview": {
            "type": "boolean",
            "default": false
        },
        "ShortDescription": {
            "type": "text"
        },
        "Thumbnail": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "images",
                "files",
                "videos",
                "audios"
            ]
        }
    }
}
